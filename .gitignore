# ─── Root .gitignore (mono-repo) ─────────────────────────────────────────────
# backend/ and frontend/ each have their own .gitignore too.

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Python virtual environment (shared at root)
.venv/
venv/
env/
ENV/

# Byte-compiled
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Excel data (contains patient data — do not commit)
waiting-list.xlsx
*.xlsx

# Secrets
.env
*.env.local
*.env.production

# Build artefacts
dist/
build/
*.egg-info/
*.egg

# Logs / test coverage
*.log
logs/
.pytest_cache/
.coverage
htmlcov/

# Node (if frontend adds a build step)
node_modules/
.cache/
